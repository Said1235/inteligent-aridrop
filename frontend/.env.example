# Contract address is per-network now (see src/lib/chain.ts) — this file only
# needs to set NEXT_PUBLIC_CONTRACT_ADDRESS if you're overriding the default
# address already wired in for whichever network you pick below. Leave it
# commented out to use that network's own last-known-deployed address.
# NEXT_PUBLIC_CONTRACT_ADDRESS=

# Which GenLayer network the contract lives on.
#   studioDevnet     chain 61997  https://studio-next.genlayer.com/api  (default — "Studio Next")
#                    default contract: 0x6f8D867fB662fd0f07fd529E2369A46D12F52d6A
#   testnetBradbury  chain 4221   https://rpc-bradbury.genlayer.com     (public testnet)
#                    default contract: 0x8188f355d6ebED82774A670daCA414B34656a855
#   studionet        chain 61999  https://studio.genlayer.com/api      (the older StudioNet)
#                    default contract: 0x0ef4Dc745B60609cFeDE21340A8cDbE4B0058525 (unconfirmed on this chain)
# See the network section of README.md before changing this — confirm which
# chain your contract is actually deployed on before assuming the default is
# right for you.
NEXT_PUBLIC_GENLAYER_NETWORK=studioDevnet

# Optional overrides. Leave blank to use the network's own defaults above.
# NEXT_PUBLIC_GENLAYER_RPC_URL=
# NEXT_PUBLIC_EXPLORER_URL=
