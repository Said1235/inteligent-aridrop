# GenLayer RPC API URL — Studio Next (Consensus v0.6), mandatory deploy target
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api

# GenLayer network configuration — change together if you target another deployment
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio Next
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# Address of your deployed IntelligentAirdrop contract on Studio Next
NEXT_PUBLIC_CONTRACT_ADDRESS=your_contract_address
