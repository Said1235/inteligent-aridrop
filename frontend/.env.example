# The deployed IntelligentAirdrop contract.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0ef4Dc745B60609cFeDE21340A8cDbE4B0058525

# Which GenLayer Studio network the contract lives on.
#   studionet     chain 61999  https://studio.genlayer.com/api      (default)
#   studioDevnet  chain 61997  https://studio-dev.genlayer.com/api  (no explorer)
# See the network section of README.md before changing this.
NEXT_PUBLIC_GENLAYER_NETWORK=studionet

# Optional overrides. Leave blank to use the chain's own values.
# NEXT_PUBLIC_GENLAYER_RPC_URL=
# NEXT_PUBLIC_EXPLORER_URL=
